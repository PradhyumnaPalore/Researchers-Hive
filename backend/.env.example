# Copy this file to backend/.env for local development, or set these as
# real environment variables in your hosting provider's dashboard for prod.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend-domain.onrender.com
DJANGO_CORS_ORIGINS=https://your-frontend-domain.vercel.app

# MongoDB Atlas connection string (or local mongodb://localhost:27017)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_DB_NAME=ResearchersHive

# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
